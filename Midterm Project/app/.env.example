# Optional: needed only for OpenAI-generated answers.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Optional local generation. Start Ollama and pull a model before choosing this mode.
OLLAMA_MODEL=gemma4:latest
# Model weights download once; set a local model path for an offline deployment.
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# Permit model download on first app load on a fresh deployment (optional).
ALLOW_MODEL_DOWNLOAD=0
RAG_CPU_THREADS=2
